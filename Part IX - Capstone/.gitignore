# Python virtual environments
.venv/

# Python cache files
__pycache__/
*.py[cod]

# Jupyter
.ipynb_checkpoints/

# Environment variables and secrets
.env
.env.*
!.env.example

# Original raw data: keep locally, not in Git
data/raw/*
